{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "//": "Оснастка агентов jorqen, в git. Личные переопределения — .claude/settings.local.json (не коммитится).",
  "permissions": {
    "//allow": "Автоодобрен только безопасный и обратимый обиход. Команды scout перечислены ПОШТУЧНО, а не префиксом `scout:*`, потому что среди них есть необратимые и платные — см. //deny.",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(scripts/build_resume_formats.sh:*)",
      "Bash(.venv/bin/python -m scripts.scout budget:*)",
      "Bash(.venv/bin/python -m scripts.scout shortlist:*)",
      "Bash(.venv/bin/python -m scripts.scout new:*)",
      "Bash(.venv/bin/python -m scripts.scout status:*)",
      "Bash(.venv/bin/python -m scripts.scout coverage:*)",
      "Bash(.venv/bin/python -m scripts.scout card:*)",
      "Bash(.venv/bin/python -m scripts.scout brief:*)",
      "Bash(.venv/bin/python -m scripts.scout detail:*)",
      "Bash(.venv/bin/python -m scripts.scout employer:*)",
      "Bash(.venv/bin/python -m scripts.scout research:*)",
      "Bash(.venv/bin/python -m scripts.scout resolve:*)",
      "Bash(.venv/bin/python -m scripts.scout channel:*)",
      "Bash(.venv/bin/python -m scripts.scout ats:*)",
      "Bash(.venv/bin/python -m scripts.scout check-links:*)",
      "Bash(.venv/bin/python -m scripts.scout mark:*)",
      "Bash(.venv/bin/python -m scripts.scout auth status:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(du:*)",
      "Bash(tree:*)"
    ],
    "//deny": "Платное, необратимое и всё, что выходит наружу от имени человека. Эти команды обязаны спрашивать КАЖДЫЙ раз — не переносить в allow. `reveal` тут больше НЕТ намеренно: deny отклоняет вызов молча, без вопроса, то есть агент не может раскрыть контакт даже с прямого разрешения в чате (09.08.2026 это стоило трёх нераскрытых контактов). Он спрашивает обычным порядком, как и задумано этой строкой.",
    "deny": [
      "Bash(.venv/bin/python -m scripts.scout tg-mirror:*)",
      "Bash(.venv/bin/python -m scripts.scout tg-rollback:*)",
      "Bash(.venv/bin/python -m scripts.scout auth import:*)",
      "Bash(.venv/bin/python -m scripts.scout auth secure:*)",
      "Read(./.auth/**)",
      "Read(./.venv/**)"
    ]
  }
}
